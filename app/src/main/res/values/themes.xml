<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash natif invisible (fond seulement) -->
    <style name="Theme.Learnity.SplashScreen" parent="Theme.SplashScreen">
        <!-- ✅ Même couleur que le splash Composable -->
        <item name="windowSplashScreenBackground">#F5F7FA</item>

        <!-- ✅ PAS D'ICÔNE = invisible -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@drawable/icon_learnity</item> -->

        <!-- Durée 0 = transition immédiate -->
        <item name="windowSplashScreenAnimationDuration">0</item>

        <item name="postSplashScreenTheme">@style/Theme.Learnity</item>
    </style>

    <!-- Thème principal -->
    <style name="Theme.Learnity" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>